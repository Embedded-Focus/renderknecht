# Debian 13 (trixie), pinned by image digest so the base cannot drift.
# See https://hub.docker.com/_/debian for the tag that digest belongs to.
FROM debian:trixie-slim@sha256:89c1ea91e897f0fe0a3731595330bc45b8bdef4047464a07116f891a94054b31

LABEL org.opencontainers.image.authors="Rainer Poisel <rainer@honeytreelabs.com>"

# Versions and checksums. Bump one at a time, then run a few renders and make sure
# that the PDF output still looks right.
ARG SNAPSHOT_DATE=20261020T213255Z
ARG UV_VERSION=0.13.6
ARG UV_SHA256=f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645
ARG PANDOC_VERSION=3.13
ARG PANDOC_SHA256=38aa33b325a2bc96a4c39409631212db55702f564250bcdbead180b3bf646389
# pandoc-crossref is built for one pandoc version. Change it together with
# PANDOC_VERSION, or the filter stops working.
ARG PANDOC_CROSSREF_VERSION=v0.3.26
ARG PANDOC_CROSSREF_SHA256=83d09646629234dfcd3d267e28184f46b9d468e98508efb3542b014634bfe999
ARG EISVOGEL_VERSION=3.5.1
ARG EISVOGEL_SHA256=321ff753b4017e331575651bf97ba51004650762fe116be97a4c60a68c570181
ARG NODE_VERSION=v26.12.1
ARG NODE_SHA256=6170b2d474e1c626f43cff3adc118df9fe3b573258a4fc3d850c8dbc6b079bbd
# mermaid-cli 12.0.0 is the newest CLI release. It needs mermaid ^12.0.0, so this
# build installs mermaid 12.2.0 as well. A test makes sure that mmdc loads that copy.
ARG MERMAID_CLI_VERSION=12.0.0
ARG MERMAID_VERSION=12.2.0

ENV DEBIAN_FRONTEND=noninteractive
# The Python interpreter comes from Debian. uv must not download another one.
ENV UV_PYTHON_DOWNLOADS=never

# Every apt package comes from one Debian snapshot, so a rebuild sees the same
# versions. Snapshot dates expire, hence Check-Valid-Until is off. Security
# updates enter the image when you change SNAPSHOT_DATE, because the security
# pocket is not part of this line.
#
# Packages that decide what the PDF looks like carry a version suffix. If apt
# cannot find such a version, the build stops. Otherwise the build silently uses a
# different toolchain. The packages without a suffix only need to exist, so they
# carry no version.
#
# The names that start with lib and carry no version are libraries. The Chrome
# headless shell needs them to start. The list comes from ldd on that binary. Node.js
# needs libstdc++6, which is in that group too.
RUN printf 'deb http://snapshot.debian.org/archive/debian/%s trixie main\n' "${SNAPSHOT_DATE}" \
        > /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -yy \
        bind9-dnsutils \
        ca-certificates \
        curl \
        fontconfig \
        fonts-liberation \
        graphviz=2.42.4-3 \
        libasound2t64 \
        libatk-bridge2.0-0t64 \
        libatk1.0-0t64 \
        libatspi2.0-0t64 \
        libdbus-1-3 \
        libgbm1 \
        libglib2.0-0 \
        librsvg2-bin=2.60.0+dfsg-1 \
        libnspr4 \
        libnss3 \
        libstdc++6 \
        libudev1 \
        libx11-6 \
        libxcomposite1 \
        libxcb1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxkbcommon0 \
        libxrandr2 \
        python3=3.13.5-1 \
        python3-venv \
        texlive-fonts-extra=2024.20250309-2 \
        texlive-lang-german=2024.20250309-1 \
        texlive-latex-base=2024.20250309-1 \
        texlive-science=2024.20250309-2 \
        wget \
        xz-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv installs and runs the Python project.
RUN wget -q -O /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum --check \
    && tar xzf /tmp/uv.tar.gz -C /tmp \
    && install -m 0755 "/tmp/uv-x86_64-unknown-linux-gnu/uv" /usr/local/bin/uv \
    && install -m 0755 "/tmp/uv-x86_64-unknown-linux-gnu/uvx" /usr/local/bin/uvx \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu \
    && uv --version

# pandoc is the converter. We use the tarball instead of the Debian package, because
# the Debian package is older and needs extra libraries.
RUN wget -q -O /tmp/pandoc.tar.gz \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && echo "${PANDOC_SHA256}  /tmp/pandoc.tar.gz" | sha256sum --check \
    && tar xzf /tmp/pandoc.tar.gz --strip-components=1 -C /usr/local \
    && rm /tmp/pandoc.tar.gz \
    && pandoc --version | head -1

RUN wget -q -O /tmp/pandoc-crossref.tar.xz \
        "https://github.com/lierdakil/pandoc-crossref/releases/download/${PANDOC_CROSSREF_VERSION}/pandoc-crossref-Linux-X64.tar.xz" \
    && echo "${PANDOC_CROSSREF_SHA256}  /tmp/pandoc-crossref.tar.xz" | sha256sum --check \
    && tar xJf /tmp/pandoc-crossref.tar.xz -C /usr/local/bin pandoc-crossref \
    && rm /tmp/pandoc-crossref.tar.xz

# Node.js brings npm, which installs mermaid-cli. Debian has no Node.js 26 package, and
# mermaid-cli needs Node.js 22.13 or newer. The tarball is for amd64 only, like pandoc
# above.
RUN wget -q -O /tmp/node.tar.xz "https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum --check \
    && tar xJf /tmp/node.tar.xz --strip-components=1 -C /usr/local \
    && rm /tmp/node.tar.xz \
    && node --version \
    && npm --version

# mermaid-cli renders a Mermaid diagram with Chromium and writes a PDF. We do not
# use SVG, because librsvg cannot convert Mermaid SVG. See renderers/pandoc.py.
#
# mermaid-cli asks for mermaid ^12.0.0. This step asks for mermaid 12.2.0 as well, so
# npm installs that version at the global root. If npm puts another copy under
# mermaid-cli, the build stops. mmdc loads that copy instead of the pinned one.
#
# Chrome comes from the puppeteer version inside mermaid-cli, so that version sets the
# Chrome build. mermaid-cli starts the Chrome headless shell, so only that build is
# here. The build deletes old revisions, because each one costs about 300 MB.
RUN PUPPETEER_SKIP_DOWNLOAD=1 npm install --global --no-audit --no-fund \
        "@mermaid-js/mermaid-cli@${MERMAID_CLI_VERSION}" "mermaid@${MERMAID_VERSION}" \
    && test ! -e /usr/local/lib/node_modules/@mermaid-js/mermaid-cli/node_modules/mermaid \
    && node --eval \
        "console.log('mermaid', require('/usr/local/lib/node_modules/mermaid/package.json').version)" \
    && puppeteer_bin=/usr/local/lib/node_modules/@mermaid-js/mermaid-cli/node_modules/.bin/puppeteer \
    && "$puppeteer_bin" browsers install chrome-headless-shell \
    && ls -d /root/.cache/puppeteer/chrome-headless-shell/* 2>/dev/null | sort -V | head -n -1 \
            | xargs --no-run-if-empty rm -rf \
    && mmdc --version

# Chromium must run without its sandbox, because it runs as root in the container.
RUN mkdir -p /etc/renderknecht \
    && printf '{"args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]}\n' \
        > /etc/renderknecht/puppeteer.json

# One Mermaid render at build time. If mmdc cannot render it, the build stops. A broken
# browser otherwise fails on the first real document. The second test shows that Chrome
# put a font in the PDF. Chrome draws no text when it finds no font, so a diagram
# without text can pass the first test. This test is a hint, not a proof.
RUN printf 'graph TD\n  A-->B\n' > /tmp/mermaid-smoke.mmd \
    && mmdc -i /tmp/mermaid-smoke.mmd -o /tmp/mermaid-smoke.pdf -p /etc/renderknecht/puppeteer.json \
    && grep -q '%PDF-' /tmp/mermaid-smoke.pdf && grep -q '/Font' /tmp/mermaid-smoke.pdf \
    && test -s /tmp/mermaid-smoke.pdf && rm -f /tmp/mermaid-smoke.mmd /tmp/mermaid-smoke.pdf

ARG PANDOC_DIR=/.pandoc
ARG TEMPLATES_DIR=${PANDOC_DIR}/templates

RUN mkdir -p ${TEMPLATES_DIR} \
    && ln -s ${PANDOC_DIR} /root/.pandoc

# CSL styles can be found in this repo: https://github.com/citation-style-language/styles
RUN wget -q -O /tmp/eisvogel.tar.gz \
        "https://github.com/Wandmalfarbe/pandoc-latex-template/releases/download/v${EISVOGEL_VERSION}/Eisvogel-${EISVOGEL_VERSION}.tar.gz" \
    && echo "${EISVOGEL_SHA256}  /tmp/eisvogel.tar.gz" | sha256sum --check \
    && tar xzf /tmp/eisvogel.tar.gz --strip-components=1 -C ${TEMPLATES_DIR} Eisvogel-${EISVOGEL_VERSION}/eisvogel.latex \
    && rm /tmp/eisvogel.tar.gz

ARG GIT_HASH=unknown
ENV RENDERKNECHT_GIT_HASH=$GIT_HASH

# We just copy the whole application including tests into the pandoc directory.
# I don't care that this is not perfect. We also use the Flask built-in webserver.
# That's all good enough for what we want to achieve ...

COPY ./pyproject.toml ./uv.lock ./README.md ${PANDOC_DIR}/
COPY ./src/renderknecht/ ${PANDOC_DIR}/src/renderknecht/

WORKDIR ${PANDOC_DIR}

# --locked stops the build when uv.lock does not match pyproject.toml.
RUN uv sync --locked

ENV PATH=${PANDOC_DIR}/.venv/bin:${PATH}

# One render at build time through the same code path that a real document uses. The
# test uses preamble.yaml, the pandoc filters and the template. The front matter turns
# on pandoc-crossref, so that filter runs too. If the render fails, the build stops.
# The test finds the fault in the image build, not in the first real document. See
# renderers/pandoc.py and util/pandoc_wrapper.py.
RUN printf -- '---\npandoc-options: [crossref]\n---\n\n# One {#sec:one}\n\nA formula: $E=mc^2$\n\n```python\nprint("ok")\n```\n\nSee @sec:one.\n' \
        > /tmp/smoke.md \
    && python -c "from pathlib import Path; from renderknecht.renderers import pandoc; tmp = []; Path('/tmp/smoke.pdf').write_bytes(pandoc.render_markdown(Path('/tmp/smoke.md').read_text(), tmp))" \
    && grep -q '%PDF-' /tmp/smoke.pdf && rm -f /tmp/smoke.md /tmp/smoke.pdf

COPY entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint"]
