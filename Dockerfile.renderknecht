ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.13-python3.14-trixie-slim@sha256:d2525beeae88affd18389bf69292abf9b5cbbb3f5c5242b6da3d20e304959b37
FROM ${UV_IMAGE}

ARG RENDERKNECHT_VERSION=0.1.0
ARG GIT_HASH=unknown
ARG PANDOC_VERSION=3.9
ARG PANDOC_CROSSREF_VERSION=0.3.24a
ARG EISVOGEL_VERSION=3.4.0
ARG PANDOC_AMD64_SHA256=872a10c7ec29d5278831d855b11bd4ade0df4d5ec9a089a3197bc63a37eb4003
ARG PANDOC_ARM64_SHA256=e09b97d7313bd417a35bde6c747c458486ec84f696e1cfd0f8c527cd69c89433
ARG CROSSREF_AMD64_SHA256=afaa8867ab8d908b7e5ad1b96f62eedea6a5d3e89ee14e152cd72e67f535a728
ARG CROSSREF_ARM64_SHA256=b3e2c10321c142f561bb20f98824a8e2e41385118a22fd2168b55e7699be69b6
ARG EISVOGEL_SHA256=7b631248ab30592fb18bd52d57dc078583137e18d9f4ef55fc1fb42ed6f7699c

LABEL org.opencontainers.image.authors="Rainer Poisel <rainer@honeytreelabs.com>" \
      org.opencontainers.image.source="https://github.com/Embedded-Focus/renderknecht" \
      org.opencontainers.image.description="Renderknecht Markdown-to-PDF renderer" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.version="${RENDERKNECHT_VERSION}" \
      org.opencontainers.image.revision="${GIT_HASH}"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bind9-dnsutils \
        ca-certificates \
        curl \
        graphviz \
        librsvg2-bin \
        texlive-fonts-extra \
        texlive-latex-base \
        texlive-science \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ARG TARGETARCH
RUN set -eu; \
    architecture="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$architecture" in \
        amd64) pandoc_sha="${PANDOC_AMD64_SHA256}"; crossref_arch="X64"; crossref_sha="${CROSSREF_AMD64_SHA256}" ;; \
        arm64) pandoc_sha="${PANDOC_ARM64_SHA256}"; crossref_arch="ARM64"; crossref_sha="${CROSSREF_ARM64_SHA256}" ;; \
        *) echo "Unsupported architecture: $architecture" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --show-error \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-${architecture}.tar.gz" \
        --output /tmp/pandoc.tar.gz; \
    echo "${pandoc_sha}  /tmp/pandoc.tar.gz" | sha256sum --check -; \
    tar -xzf /tmp/pandoc.tar.gz --strip-components=1 -C /usr/local; \
    curl --fail --location --show-error \
        "https://github.com/lierdakil/pandoc-crossref/releases/download/v${PANDOC_CROSSREF_VERSION}/pandoc-crossref-Linux-${crossref_arch}.tar.xz" \
        --output /tmp/pandoc-crossref.tar.xz; \
    echo "${crossref_sha}  /tmp/pandoc-crossref.tar.xz" | sha256sum --check -; \
    tar -xJf /tmp/pandoc-crossref.tar.xz -C /usr/local/bin pandoc-crossref; \
    rm /tmp/pandoc.tar.gz /tmp/pandoc-crossref.tar.xz

ARG PANDOC_DIR=/.pandoc
ARG TEMPLATES_DIR=${PANDOC_DIR}/templates

RUN mkdir -p ${TEMPLATES_DIR} \
    && ln -s ${PANDOC_DIR} /root/.pandoc

ENV RENDERKNECHT_GIT_HASH=$GIT_HASH

RUN curl --fail --location --show-error \
        "https://github.com/Wandmalfarbe/pandoc-latex-template/releases/download/v${EISVOGEL_VERSION}/Eisvogel-${EISVOGEL_VERSION}.tar.gz" \
        --output /tmp/eisvogel.tar.gz \
    && echo "${EISVOGEL_SHA256}  /tmp/eisvogel.tar.gz" | sha256sum --check - \
    && tar xz --strip-components=1 -C ${TEMPLATES_DIR} -f /tmp/eisvogel.tar.gz Eisvogel-${EISVOGEL_VERSION}/eisvogel.latex \
    && rm /tmp/eisvogel.tar.gz

COPY ./pyproject.toml ./uv.lock ./README.md ${PANDOC_DIR}/
COPY ./src/renderknecht/ ${PANDOC_DIR}/src/renderknecht/

WORKDIR ${PANDOC_DIR}

RUN uv sync --extra container --no-dev --frozen

ENV PATH=${PANDOC_DIR}/.venv/bin:${PATH}

COPY entrypoint.sh /usr/local/bin/entrypoint
RUN chmod 0755 /usr/local/bin/entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint"]
