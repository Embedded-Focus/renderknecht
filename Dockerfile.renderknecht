# Debian 13 (trixie), pinned by image digest so the base cannot drift.
# See https://hub.docker.com/_/debian for the tag that digest belongs to.
FROM debian:trixie-slim@sha256:89c1ea91e897f0fe0a3731595330bc45b8bdef4047464a07116f891a94054b31

LABEL org.opencontainers.image.authors="Rainer Poisel <rainer@honeytreelabs.com>"

# Versions and checksums. Bump one at a time, then run a few renders to check
# that the PDF output still looks right.
ARG SNAPSHOT_DATE=20261020T213255Z
ARG UV_VERSION=0.13.6
ARG UV_SHA256=f29c3e94ffabd7e6f3ba521dba169a9b7ec12100bf3257087f0f24f6123f3645
ARG PANDOC_VERSION=3.13
ARG PANDOC_SHA256=38aa33b325a2bc96a4c39409631212db55702f564250bcdbead180b3bf646389
# pandoc-crossref is built for one pandoc version. Change it together with
# PANDOC_VERSION, or the filter stops working.
ARG PANDOC_CROSSREF_VERSION=v0.3.26
ARG PANDOC_CROSSREF_SHA256=83d09646629234dfcd3d267e28184f46b9d468e98508efb3542b014634bfe999
ARG EISVOGEL_VERSION=3.5.1
ARG EISVOGEL_SHA256=321ff753b4017e331575651bf97ba51004650762fe116be97a4c60a68c570181

ENV DEBIAN_FRONTEND=noninteractive
# The Python interpreter comes from Debian. uv must not download another one.
ENV UV_PYTHON_DOWNLOADS=never

# Every apt package comes from one Debian snapshot, so a rebuild sees the same
# versions. Snapshot dates expire, hence Check-Valid-Until is off. Security
# updates enter the image when you change SNAPSHOT_DATE, because the security
# pocket is not part of this line.
#
# Packages that decide what the PDF looks like carry a version suffix. If apt
# cannot find such a version, the build stops. Otherwise the build would quietly
# use a different toolchain. The packages without a suffix only need to exist, so
# they carry no version.
RUN printf 'deb http://snapshot.debian.org/archive/debian/%s trixie main\n' "${SNAPSHOT_DATE}" \
        > /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99snapshot \
    && apt-get update \
    && apt-get install -yy \
        bind9-dnsutils \
        ca-certificates \
        curl \
        graphviz=2.42.4-3 \
        librsvg2-bin=2.60.0+dfsg-1 \
        python3=3.13.5-1 \
        python3-venv \
        texlive-fonts-extra=2024.20250309-2 \
        texlive-lang-german=2024.20250309-1 \
        texlive-latex-base=2024.20250309-1 \
        texlive-science=2024.20250309-2 \
        wget \
        xz-utils \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv installs and runs the Python project.
RUN wget -q -O /tmp/uv.tar.gz \
        "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && echo "${UV_SHA256}  /tmp/uv.tar.gz" | sha256sum --check \
    && tar xzf /tmp/uv.tar.gz -C /tmp \
    && install -m 0755 "/tmp/uv-x86_64-unknown-linux-gnu/uv" /usr/local/bin/uv \
    && install -m 0755 "/tmp/uv-x86_64-unknown-linux-gnu/uvx" /usr/local/bin/uvx \
    && rm -rf /tmp/uv.tar.gz /tmp/uv-x86_64-unknown-linux-gnu \
    && uv --version

# pandoc is the converter. The tarball is used instead of the Debian package,
# because the Debian package is older and needs extra libraries.
RUN wget -q -O /tmp/pandoc.tar.gz \
        "https://github.com/jgm/pandoc/releases/download/${PANDOC_VERSION}/pandoc-${PANDOC_VERSION}-linux-amd64.tar.gz" \
    && echo "${PANDOC_SHA256}  /tmp/pandoc.tar.gz" | sha256sum --check \
    && tar xzf /tmp/pandoc.tar.gz --strip-components=1 -C /usr/local \
    && rm /tmp/pandoc.tar.gz \
    && pandoc --version | head -1

RUN wget -q -O /tmp/pandoc-crossref.tar.xz \
        "https://github.com/lierdakil/pandoc-crossref/releases/download/${PANDOC_CROSSREF_VERSION}/pandoc-crossref-Linux-X64.tar.xz" \
    && echo "${PANDOC_CROSSREF_SHA256}  /tmp/pandoc-crossref.tar.xz" | sha256sum --check \
    && tar xJf /tmp/pandoc-crossref.tar.xz -C /usr/local/bin pandoc-crossref \
    && rm /tmp/pandoc-crossref.tar.xz

ARG PANDOC_DIR=/.pandoc
ARG TEMPLATES_DIR=${PANDOC_DIR}/templates

RUN mkdir -p ${TEMPLATES_DIR} \
    && ln -s ${PANDOC_DIR} /root/.pandoc

# CSL styles can be found in this repo: https://github.com/citation-style-language/styles
RUN wget -q -O /tmp/eisvogel.tar.gz \
        "https://github.com/Wandmalfarbe/pandoc-latex-template/releases/download/v${EISVOGEL_VERSION}/Eisvogel-${EISVOGEL_VERSION}.tar.gz" \
    && echo "${EISVOGEL_SHA256}  /tmp/eisvogel.tar.gz" | sha256sum --check \
    && tar xzf /tmp/eisvogel.tar.gz --strip-components=1 -C ${TEMPLATES_DIR} Eisvogel-${EISVOGEL_VERSION}/eisvogel.latex \
    && rm /tmp/eisvogel.tar.gz

ARG GIT_HASH=unknown
ENV RENDERKNECHT_GIT_HASH=$GIT_HASH

# We just copy the whole application including tests into the pandoc directory.
# I don't care that this is not perfect. We also use the Flask built-in webserver.
# That's all good enough for what we want to achieve ...

COPY ./pyproject.toml ./uv.lock ./README.md ${PANDOC_DIR}/
COPY ./src/renderknecht/ ${PANDOC_DIR}/src/renderknecht/

WORKDIR ${PANDOC_DIR}

# --locked stops the build when uv.lock does not match pyproject.toml.
RUN uv sync --locked

ENV PATH=${PANDOC_DIR}/.venv/bin:${PATH}

# One render at build time. pandoc, LaTeX and the template all run here. If the
# render fails, the build stops. That is better than the first real document
# failing days later. The check also runs pandoc-crossref, because that filter is
# built for one pandoc version and breaks when the two do not fit. The check does
# not run every pandoc option. For the full list see util/pandoc_wrapper.py.
RUN printf '# Smoke test\n\nA formula: $E=mc^2$\n\n```python\nprint("ok")\n```\n' > /tmp/smoke.md \
    && pandoc /tmp/smoke.md --output /tmp/smoke.pdf --standalone \
        --from markdown --template eisvogel --syntax-highlighting=idiomatic \
        --filter pandoc-crossref \
    && grep -q '%PDF-' /tmp/smoke.pdf && rm -f /tmp/smoke.md /tmp/smoke.pdf

COPY entrypoint.sh /usr/local/bin/entrypoint
RUN chmod +x /usr/local/bin/entrypoint
ENTRYPOINT ["/usr/local/bin/entrypoint"]
